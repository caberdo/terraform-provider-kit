// Command terraform-provider-{{PROVIDER}} serves the Terraform provider.
package main

//go:generate go run github.com/hashicorp/terraform-plugin-docs/cmd/tfplugindocs generate --provider-name {{PROVIDER}}

import (
	"context"
	"errors"
	"flag"
	"fmt"
	"os"

	"github.com/hashicorp/terraform-plugin-framework/providerserver"

	"{{MODULE}}/internal/provider"
)

// {{PROVIDER}}Address is the registry address Terraform uses to select this
// provider.
const {{PROVIDER}}Address = "registry.terraform.io/{{REGISTRY_NAMESPACE}}/{{PROVIDER}}"

// version is replaced at build time with
// -ldflags "-X main.version=<release>".
var version = "dev"

// errUsage marks a command-line parsing failure. The flag package has already
// written the message to stderr, so main only has to choose the exit status.
var errUsage = errors.New("usage error")

func main() {
	if err := run(os.Args[1:]); err != nil {
		if errors.Is(err, errUsage) {
			os.Exit(2)
		}
		_, _ = fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

// run parses the provider's flags and serves the plugin. It is separate from
// main so flag handling can be exercised without exiting the process.
func run(args []string) error {
	flags := flag.NewFlagSet("terraform-provider-{{PROVIDER}}", flag.ContinueOnError)
	debug := flags.Bool("debug", false, "run the provider with support for debuggers like delve")
	if err := flags.Parse(args); err != nil {
		if errors.Is(err, flag.ErrHelp) {
			return nil
		}
		return fmt.Errorf("%w: %v", errUsage, err)
	}

	return providerserver.Serve(context.Background(), provider.New(version), providerserver.ServeOpts{
		Address: {{PROVIDER}}Address,
		Debug:   *debug,
	})
}
